# Copia este archivo a `.env` (que está en .gitignore) y rellena los valores.
# Compose se niega a arrancar si POSTGRES_PASSWORD está vacía: no hay una
# contraseña por defecto insegura.
#
# Genera una con:  python -c "import secrets; print(secrets.token_hex(24))"
# (hexadecimal: va dentro de DATABASE_URL y no necesita escaparse).

POSTGRES_USER=comparativo
POSTGRES_PASSWORD=
POSTGRES_DB=comparativo

# Puerto del host (solo 127.0.0.1) para Postgres, por si corres la API sin Docker.
PUERTO_DB=5433

# Límite de cada ejecución de código en la API, en segundos.
TIEMPO_LIMITE_EJECUCION_S=60
# Espera máxima de la UI a la API; debe superar el límite anterior.
TIEMPO_ESPERA_API_S=90
NIVEL_LOG=INFO
